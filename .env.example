# Copy to `.env` to override the dev defaults used by docker-compose.yml.
# Every value here is a DEV-ONLY default. Never reuse these outside a local demo.

# Postgres
POSTGRES_USER=apaar
POSTGRES_PASSWORD=apaar
POSTGRES_DB=apaar

# Auth (JWT access 15 min, refresh 7 days). Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
CORS_ORIGINS=http://localhost:5173

# Field-level encryption at rest (phone, email, address, sponsor, OCI number, name).
# Empty = a DEV-ONLY key derived from JWT_SECRET. Generate a real one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes previously seeded data unreadable: reseed (POST /api/v1/demo/seed).
FERNET_KEY=
# HMAC pepper for privacy-preserving identity/contact tokens.
TOKEN_PEPPER=dev-only-insecure-pepper
# Reserved for credential signing (Phase 7).
SIGNING_KEY_PASSPHRASE=dev-only-insecure-passphrase

# Password for all seeded demo accounts
DEMO_PASSWORD=Demo@2026

# Synthetic national dataset, generated on first start when no student records exist
# (and on demand via POST /api/v1/demo/seed). Up to 50,000 students.
AUTO_SEED_NATIONAL=true
SYNTH_SEED=42
SYNTH_INSTITUTIONS=40
SYNTH_STUDENTS=20000

# Optional ML (off by default). LaBSE is not implemented; keep false.
ENABLE_LABSE=false
# Optional JSON {"variant": "canonical"} merged into the name variant table.
NAME_VARIANTS_FILE=
